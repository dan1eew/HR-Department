<Window x:Class="HR_Department.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HR Department"
        Loaded="WindowLoaded"
        Icon="/PNG file at 2556756480.png"
        Height="600"
        Width="1200"
        Background="#FF2B2B2B"
        FontFamily="Sitka Display"
        FontSize="18"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10,10,10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- User / Exit -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left" VerticalAlignment="Top">

                <TextBlock x:Name="FullNameBox"
                           VerticalAlignment="Center"
                           ToolTip="Текущий пользователь" FontSize="14"/>

                <Button Content="X"
                        Style="{StaticResource C5}"
                        FontSize="14"
                        Background="White"
                        BorderBrush="#FFD22A21"
                        Foreground="Black"
                        Margin="10,0,0,0"
                        Click="MainWindowClick"
                        ToolTip="Выйти из системы" Width="25" Height="25" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Time / Refresh -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom">

                <TextBlock x:Name="DateTimeBox"
                           VerticalAlignment="Center"
                           ToolTip="Текущая дата и время" FontFamily="Times New Roman" FontSize="14"/>

                <Button Content="O"
                        Style="{StaticResource C4}"
                        FontSize="14"
                        Background="White"
                        BorderBrush="#FF0086EC"
                        Foreground="Black"
                        Click="RefheshClick"
                        ToolTip="Обновить данные" Width="25" Height="25"/>
            </StackPanel>
        </Grid>

        <!-- ===== TOOLBAR ===== -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Background="#FF252525"
                    HorizontalAlignment="Left">

            <StackPanel VerticalAlignment="Center">
                <Button Content="Добавить"
                    Style="{StaticResource C4}"
                    Width="105"
                    Height="18"
                    FontSize="14"
                    Background="White"
                    BorderBrush="#FF0086EC"
                    Click="AddClick"
                    ToolTip="Добавить сотрудника"/>

                <Button Content="Редактировать"
                    Style="{StaticResource C4}"
                    Width="105"
                    Height="18"
                    FontSize="14"
                    Background="White"
                    BorderBrush="#FF0086EC"
                    Click="EditClick"
                    ToolTip="Редактировать выбранного сотрудника"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Button Content="Настройка"
                    Style="{StaticResource C6}"
                    Width="105"
                    Height="18"
                    FontSize="14"
                    Background="White"
                    BorderBrush="#FFF1610D"
                    Click="SettingsClick"
                    ToolTip="Настройка видимости"/>

                <Button Content="Удалить"
                    Style="{StaticResource C5}"
                    Width="105"
                    Height="18"
                    FontSize="14"
                    Background="White"
                    BorderBrush="#FFD22A21"
                    Click="DeleteClick"
                    ToolTip="Удалить выбранного сотрудника"/>

            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <Button Content="Печать"
                    Style="{StaticResource C6}"
                    Width="105"
                    Height="18"
                    FontSize="14"
                    Background="White"
                    BorderBrush="#FFF1610D"
                    Click="PrintButton_Click"
                    ToolTip="Отправить на печать"/>

                <Button Content="Предпросмотр"
                    Style="{StaticResource C6}"
                    Width="105"
                    Height="18"
                    FontSize="14"
                    Background="White"
                    BorderBrush="#FFF1610D"
                    Click="PrintPreviewButton_Click"
                    ToolTip="Предпросмотр" x:Name="PrintPreviewButton"/>
            </StackPanel>

            <TextBox x:Name="SearchText"
                     Width="400"
                     Height="25"
                     Margin="10,0,0,0"
                     VerticalContentAlignment="Center"
                     Background="White"
                     BorderBrush="#FF0086EC"
                     KeyUp="SearchText_KeyDown"
                     ToolTip="Поиск по ФИО, отделу, телефону, email"/>
        </StackPanel>

        <!-- ===== TABLE ===== -->
        <ListView x:Name="ListViewStaff"
                  Grid.Row="1"
                  FontFamily="Times New Roman"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0,10,0,0"
                  ToolTip="Список сотрудников">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding staff_id}"/>
                    <GridViewColumn Header="ФИО" DisplayMemberBinding="{Binding full_name}"/>
                    <GridViewColumn Header="Отдел" DisplayMemberBinding="{Binding service}"/>
                    <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding phone_number}"/>
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding email}"/>
                    <GridViewColumn Header="Дата рождения" DisplayMemberBinding="{Binding birth_date_str}"/>
                    <GridViewColumn Header="Город" DisplayMemberBinding="{Binding city}"/>
                    <GridViewColumn Header="Индекс" DisplayMemberBinding="{Binding post_number}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ===== STATUS ===== -->
        <Grid Grid.Row="3">
            <ScrollViewer>
                <TextBox x:Name="StatusTableBox"
                           FontSize="16"
                           FontFamily="Times New Roman"
                           Foreground="White"
                           BorderBrush="White"
                           TextWrapping="Wrap"
                           ToolTip="Статус операций" Height="40" VerticalContentAlignment="Center"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
