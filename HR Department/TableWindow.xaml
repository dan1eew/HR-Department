<Window x:Class="HR_Department.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Department"
        mc:Ignorable="d" Height="600" Width="1200"
        Background="#FFAFAFAF" Foreground="White"
        FontFamily="Sitka Display" FontSize="18">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Left" Margin="10,0,0,0">
            <Label Content="HR Deportament" FontSize="35" 
                    HorizontalAlignment="Center" FontWeight="Bold"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="ListViewStaff" Grid.Row="0" Background="#FF252525"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Фамилия Имя Отчество" DisplayMemberBinding="{Binding full_name}"/>
                        <GridViewColumn Header="Отдел" DisplayMemberBinding="{Binding service}"/>
                        <GridViewColumn Header="Номер телефона" DisplayMemberBinding="{Binding phone_number}"/>
                        <GridViewColumn Header="Электронная почта" DisplayMemberBinding="{Binding email}"/>
                        <GridViewColumn Header="Дата рождения" DisplayMemberBinding="{Binding birth_date}"/>
                        <GridViewColumn Header="Город" DisplayMemberBinding="{Binding city}"/>
                        <GridViewColumn Header="Почтовый индекс" DisplayMemberBinding="{Binding post_number}"/>
                    </GridView>
                </ListView.View>


            </ListView>
        </Grid>
    </Grid>
</Window>
