<Application x:Class="HR_Department.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- ===== BASE COLORS ===== -->
        <Color x:Key="BlueAccent">#FF0086EC</Color>
        <Color x:Key="RedAccent">#FFD22A21</Color>
        <Color x:Key="OrangeAccent">#FFF1610D</Color>

        <!-- ===== BUTTON STYLES ===== -->

        <!-- C4 – Primary (Blue) -->
        <Style x:Key="C4" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- C5 – Danger (Red) -->
        <Style x:Key="C5" TargetType="Button" BasedOn="{StaticResource C4}">
            <Setter Property="BorderBrush" Value="{StaticResource RedAccent}"/>
        </Style>

        <!-- C6 – Warning (Orange) -->
        <Style x:Key="C6" TargetType="Button" BasedOn="{StaticResource C4}">
            <Setter Property="BorderBrush" Value="{StaticResource OrangeAccent}"/>
        </Style>

    </Application.Resources>
</Application>
