<Window x:Class="HR_Department.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="900" Width="700" Icon="/PNG file at 2556756480.png"
        FontFamily="Sitka Display"
        FontSize="15">
    
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" 
                Orientation="Horizontal" 
                HorizontalAlignment="Right"
                Margin="0,5,5,5">
            
            <Button x:Name="PrintButton" 
                Content="Печатать" 
                Width="80"
                Height="30"
                Style="{StaticResource C4}"
                Background="White"
                BorderBrush="#FF0086EC"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="5"/>
            
            <Button x:Name="CloseButton" 
                Content="Закрыть" 
                Width="80"
                Height="30"
                Style="{StaticResource C5}"
                Background="White"
                BorderBrush="#FFD22A21"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="5"/>
        </StackPanel>

        <FlowDocumentScrollViewer x:Name="DocumentViewer"/>
    </DockPanel>
</Window>
