<Window x:Class="HR_Department.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen" Icon="/PNG file at 2556756480.png"
        Width="320" Height="300" FontFamily="Sitka Display"
        FontSize="18"
        ResizeMode="CanMinimize">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
               Text="Выберите, какие столбцы отображать в таблице" 
               TextWrapping="Wrap" 
               Margin="0,0,0,10"
               TextAlignment="Center"/>

        <!-- Список столбцов -->
        <Border Grid.Row="1" 
            BorderBrush="LightGray" 
            BorderThickness="1" 
            Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ColumnsPanel" Margin="5">
                    <!-- CheckBox будут добавлены в коде -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center">
            <Button Content="Закрыть"
                Style="{StaticResource C5}"
                Width="85"
                Height="20"
                Background="White"
                BorderBrush="#FFD22A21"
                Click="Cancel_Click"
                ToolTip="Выйти" FontSize="15"/>
            <Button Content="Сохранить"
                Style="{StaticResource C4}"
                Width="85"
                Height="20"
                Margin="10,0,0,0"
                Background="White"
                BorderBrush="#FF0086EC"
                Click="OK_Click"
                ToolTip="Сохранить" FontSize="15"/>
            <Button Content="Выбрать всё" x:Name="BtnSelectAll" Click="SelectAll_Click"
                Style="{StaticResource C4}"
                Width="85"
                Height="20"
                Margin="10,0,0,0"
                Background="White"
                BorderBrush="#FF0086EC"
                ToolTip="Выбрать всё" FontSize="15"/>
        </StackPanel>
        </Grid>
</Window>
