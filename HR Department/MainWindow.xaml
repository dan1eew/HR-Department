<Window x:Class="HR_Department.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="550"
        Width="550"
        FontFamily="Sitka Display"
        FontSize="18"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FF2B2B2B"
        Foreground="White"
        Icon="/PNG file at 2556756480.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <Label Content="HR Department"
                   FontSize="35"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="White"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FF252525"
                CornerRadius="20"
                Margin="10,0">

            <Grid>
                <StackPanel Height="103"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                    <Label Content="Вход"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>
                </StackPanel>

                <Label Content="Логин:"
                       Foreground="White"
                       Margin="10,100,0,0"/>

                <TextBox x:Name="LoginBox"
                         Margin="168,103,15,0"
                         Height="25"
                         Background="White"
                         FontFamily="Times New Roman" VerticalAlignment="Top"/>

                <Label Content="Пароль:"
                       Foreground="White"
                       Margin="10,150,0,0"/>

                <PasswordBox x:Name="PasswordBox"
                             Margin="168,153,15,0"
                             Height="25"
                             Background="White" VerticalAlignment="Top"/>

                <Label Content="Повторите пароль:"
                       Foreground="White"
                       Margin="10,200,0,0"/>

                <PasswordBox x:Name="PasswordBox2"
                             Margin="168,203,15,0"
                             Height="25"
                             Background="White" VerticalAlignment="Top"/>

                <TextBlock x:Name="StatusMainBox"
                           Margin="10,260,10,0"
                           HorizontalAlignment="Center"
                           Background="Red"
                           Height="20"/>

                <Button Content="Войти"
                        Width="100"
                        Height="30"
                        Style="{StaticResource C4}"
                        Background="White"
                        BorderBrush="#FF0086EC"
                        HorizontalAlignment="Right"
                        Margin="0,0,20,20"
                        VerticalAlignment="Bottom"
                        Click="LoginClick"/>

                <Button Content="Выйти"
                        Width="100"
                        Height="30"
                        Style="{StaticResource C5}"
                        Background="White"
                        BorderBrush="#FFD22A21"
                        HorizontalAlignment="Right"
                        Margin="0,0,140,20"
                        VerticalAlignment="Bottom"
                        Click="ExitClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
