<Window x:Class="HR_Department.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Department"
        mc:Ignorable="d"
        Height="550"
        Width="550"
        FontFamily="Sitka Display"
        FontSize="18"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="White"
        Foreground="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <StackPanel Grid.Row="0"
                    Margin="10">
            <Label Content="HR Department"
                   FontSize="35"
                   FontWeight="Bold"
                   Height="50"
                   HorizontalAlignment="Center"
                   ToolTip="Система управления персоналом"/>
        </StackPanel>

        <!-- ===== LOGIN FORM ===== -->
        <Border Grid.Row="1"
                Background="#FF252525"
                CornerRadius="20"
                Margin="10,0">

            <Grid>
                <!-- Title -->
                <StackPanel Height="103"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                    <Label Content="Вход"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Login -->
                <Label Content="Логин:"
                       Foreground="White"
                       Margin="10,100,0,0"
                       VerticalAlignment="Top"
                       ToolTip="Введите логин администратора"/>

                <TextBox x:Name="LoginBox"
                         Margin="168,103,15,0"
                         Height="25"
                         Background="White"
                         BorderBrush="White"
                         FontFamily="Times New Roman"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Top"
                         ToolTip="Логин для входа"/>

                <!-- Password -->
                <Label Content="Пароль:"
                       Foreground="White"
                       Margin="10,150,0,0"
                       VerticalAlignment="Top"
                       ToolTip="Введите пароль"/>

                <PasswordBox x:Name="PasswordBox"
                             Margin="168,153,15,0"
                             Height="25"
                             Background="White"
                             BorderBrush="White"
                             FontFamily="Times New Roman"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Top"
                             ToolTip="Пароль"/>

                <!-- Repeat password -->
                <Label Content="Повторите пароль:"
                       Foreground="White"
                       Margin="10,200,0,0"
                       VerticalAlignment="Top"
                       ToolTip="Повтор пароля для проверки"/>

                <PasswordBox x:Name="PasswordBox2"
                             Margin="168,203,15,0"
                             Height="25"
                             Background="White"
                             BorderBrush="White"
                             FontFamily="Times New Roman"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Top"
                             ToolTip="Повторите пароль"/>

                <!-- Status -->
                <TextBlock x:Name="StatusMainBox"
                           Margin="10,250,10,0"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           FontFamily="Times New Roman"
                           Background="Red"
                           TextWrapping="Wrap"
                           ToolTip="Сообщения об ошибках"/>

                <!-- Login button -->
                <Button Content="Войти"
                        Width="150"
                        Height="40"
                        FontSize="22"
                        Style="{StaticResource C4}"
                        Background="White"
                        BorderBrush="#FF0086EC"
                        FontWeight="Bold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,20,20"
                        Click="LoginClick"
                        ToolTip="Войти в систему"/>

                <Button Content="Выйти" Click="ExitClick"
                        Width="150" Height="40" FontSize="22"
                        Style="{StaticResource C5}"
                        Background="White" BorderBrush="#FFD22A21" 
                        FontWeight="Bold"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="20,0,0,20"
                        ToolTip="Выйти из приложения"/>
            </Grid>
        </Border>

        <!-- ===== FOOTER ===== -->
        <Grid Grid.Row="2"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left">

            <Image Source="/IconInfo.png"
                   Width="15"
                   Height="16"
                   ToolTip="Информация о версии" HorizontalAlignment="Left"/>

            <Label Content="версия hrd - Lite | 01.22/10"
                   FontSize="14"
                   Height="24"
                   Padding="0,3,5,0"
                   Margin="20,0,0,0"/>
        </Grid>
    </Grid>
</Window>
