<Window x:Class="HR_Department.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Department"
        mc:Ignorable="d" Height="550" Width="550" 
        FontFamily="Sitka Display" FontSize="18" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" 
        Background="#FFAFAFAF" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,10,10,10">
            <Label Content="HR Deportament" FontSize="35" HorizontalAlignment="Center" FontWeight="Bold" Height="49"/>
            <Label Content="- система по учёту сотрудников" HorizontalAlignment="Right" Height="30"/>
        </StackPanel>

        <Border Grid.Row ="1" Background="#FF252525"
                CornerRadius="20" Margin="10,0,10,0">
            <Grid>
                <StackPanel Height="103" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Label Content="Вход" 
                       Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
                <Label Content="Логин:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,100,0,0" 
                       Foreground="White" Height="32"/>
                <TextBox VerticalAlignment="Top" Margin="168,103,15,0" Height="25" Background="#FFAFAFAF"/>
                <Label Content="Пароль:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,150,0,0" 
                        Foreground="White" Height="32"/>
                <PasswordBox VerticalAlignment="Top" Margin="168,153,15,0" Height="25" Background="#FFAFAFAF"/>
                <Label Content="Повторите пароль:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,200,0,0" 
                        Foreground="White" Height="32"/>
                <PasswordBox VerticalAlignment="Top" Margin="168,203,15,0" Height="25" Background="#FFAFAFAF"/>

                <Button Content="Войти" Background="#FFF5CF46" Width="150" Height="40" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,25" BorderBrush="#FFAFAFAF"/>

            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="10,0,0,0" 
                    Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="!" FontSize="24" 
                   VerticalContentAlignment="Center" VerticalAlignment="Center" />
            <Label Content="версия hrd - lite | 01.012" FontSize="16" 
                   HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
